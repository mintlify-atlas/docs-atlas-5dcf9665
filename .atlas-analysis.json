  "projectType": "cli-tool",
  "projectName": "Spike RISC-V ISA Simulator",
  "projectDescription": "Spike is a functional RISC-V ISA simulator implementing the full RISC-V specification, supporting multiple harts, privilege modes, extensions, and interactive debugging.",
