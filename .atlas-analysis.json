  "keyFeatures": [
    "Functional simulation of RV32I/RV64I/RV32E/RV64E base ISAs",
    "Support for 80+ RISC-V standard extensions including V (vector), H (hypervisor), and cryptography",
    "Multi-hart (multi-processor) simulation",
    "Machine, Supervisor, and User privilege modes",
    "Interactive debug mode with register/memory inspection",
    "GDB/OpenOCD remote debugging via JTAG emulation",
    "Custom instruction extension support via RoCC interface",
    "MMIO plugin device system for custom hardware modeling",
    "Cache simulation (L1 I$, D$, L2)",
    "Execution logging and commit tracing",
    "RISC-V Architecture Test Framework target support"
  ],
  "publicApiSurface": [
    "spike [options] <target-program> [target-options]",
    "--isa=<string> (ISA configuration string)",
    "--priv=<m|mu|msu> (privilege modes)",
    "-p<n> (number of processors/harts)",
    "-m<n> / -m<a:m,b:n,...> (memory layout)",
    "-d (interactive debug mode)",
    "--rbb-port=<port> (remote bitbang for GDB/OpenOCD)",
    "--extension=<name> (RoCC extension)",
    "--extlib=<name> (shared library for MMIO devices)",
    "--device=<name>[,<args>] (MMIO plugin device)",
    "--ic/--dc/--l2=<S>:<W>:<B> (cache simulation)",
    "--log-commits (commit log tracing)",
    "extension_t C++ interface (custom extensions)",
    "register_extension() / REGISTER_EXTENSION macro",
    "sim_t C++ class (programmatic simulation control)"
  ]
}
